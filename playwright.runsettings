<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Playwright for .NET settings. To watch the tests run, see "Run it" in the README (Headless=false). -->
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <ExpectTimeout>5000</ExpectTimeout>
    <LaunchOptions>
      <Headless>true</Headless>
    </LaunchOptions>
  </Playwright>
  <NUnit>
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
  </NUnit>
</RunSettings>
