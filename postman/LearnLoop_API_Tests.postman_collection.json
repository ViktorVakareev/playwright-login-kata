        {
          "name": "S6 POST Register - exact field errors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"Lists exactly the three missing fields, in order\", function () {",
                  "    const fields = pm.response.json().error.fields;",
                  "    pm.expect(fields).to.eql([",
                  "        { field: \"email\", message: \"Required\" },",
                  "        { field: \"password\", message: \"Required\" },",
                  "        { field: \"name\", message: \"Required\" }",
                  "    ]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "S7 POST Register - bad email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"Bad email gets its own message, missing fields stay Required\", function () {",
                  "    const fields = pm.response.json().error.fields;",
                  "    const byField = Object.fromEntries(fields.map(f => [f.field, f.message]));",
                  "    pm.expect(byField.email).to.eql(\"Must be a valid email address\");",
                  "    pm.expect(byField.password).to.eql(\"Required\");",
                  "    pm.expect(byField.name).to.eql(\"Required\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"not-an-email\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "S8 POST Register - valid user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new email on every run, so the test can be repeated without \"already registered\".",
                  "pm.collectionVariables.set(\"newEmail\", `learner.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "pm.test(\"Echoes the user and never the password\", function () {",
                  "    const user = pm.response.json().user;",
                  "    pm.expect(user.email).to.eql(pm.collectionVariables.get(\"newEmail\"));",
                  "    pm.expect(user.name).to.eql(\"API Learner\");",
                  "    pm.expect(user).to.not.have.property(\"password\");",
                  "    pm.expect(pm.response.text()).to.not.include(\"Passw0rd!\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Passw0rd!\",\n  \"name\": \"API Learner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
