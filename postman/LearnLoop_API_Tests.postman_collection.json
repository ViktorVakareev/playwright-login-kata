    {
      "name": "Stretch",
      "item": [
        {
          "name": "S1 GET Courses - time, headers, schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Responds in under 500 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "const courseSchema = {",
                  "    type: \"object\",",
                  "    required: [\"id\", \"title\", \"subject\", \"level\", \"price\"],",
                  "    properties: {",
                  "        id: { type: \"string\" },",
                  "        title: { type: \"string\", minLength: 1 },",
                  "        subject: { type: \"string\" },",
                  "        level: { enum: [\"beginner\", \"intermediate\", \"advanced\"] },",
                  "        price: { type: \"number\", minimum: 0 },",
                  "        durationHours: { type: \"integer\", minimum: 1 },",
                  "        rating: { type: \"number\", minimum: 0, maximum: 5 }",
                  "    }",
                  "};",
                  "",
                  "pm.test(\"Every course matches the course schema\", function () {",
                  "    pm.response.to.have.jsonSchema({",
                  "        type: \"object\",",
                  "        required: [\"courses\", \"pagination\"],",
                  "        properties: { courses: { type: \"array\", items: courseSchema } }",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Default page holds the whole catalogue of 20, ids unique\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.courses).to.have.lengthOf(20);",
                  "    pm.expect(body.pagination).to.eql({ page: 1, pageSize: 20, total: 20, totalPages: 1 });",
                  "    const ids = body.courses.map(c => c.id);",
                  "    pm.expect(new Set(ids).size).to.eql(ids.length);",
                  "});",
                  "",
                  "// Keep one id for the next request (request chaining).",
                  "pm.collectionVariables.set(\"courseId\", pm.response.json().courses[3].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            }
          }
        },
        {
          "name": "S2 GET Courses - page 2 of 5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Page 2 of 5 holds 5 courses and the right metadata\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.courses).to.have.lengthOf(5);",
                  "    pm.expect(body.pagination).to.eql({ page: 2, pageSize: 5, total: 20, totalPages: 4 });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses?page=2&pageSize=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "pageSize",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "S3 GET Courses - pageSize=0 rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"pageSize=0 is rejected with 400\", () => pm.response.to.have.status(400));",
                  "",
                  "pm.test(\"The error names the pageSize field\", function () {",
                  "    const error = pm.response.json().error;",
                  "    pm.expect(error.code).to.eql(\"validation_error\");",
                  "    pm.expect(error.fields.map(f => f.field)).to.include(\"pageSize\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses?pageSize=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ],
              "query": [
                {
                  "key": "pageSize",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "S4 GET Course by id (chained)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Returns the course saved by the previous request\", function () {",
                  "    const course = pm.response.json().course;",
                  "    pm.expect(course.id).to.eql(pm.collectionVariables.get(\"courseId\"));",
                  "});"
